{
  "name": "kendall-distance-backend",
  "version": "1.0.0",
  "description": "全排列 Kendall 逆序距离与相邻交换见证后端（API 与 CLI）",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test \"dist/tests/**/*.test.js\"",
    "start": "npm run build && node dist/server.js",
    "demo": "npm run build && node dist/cli.js demo",
    "cli": "npm run build && node dist/cli.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0"
  }
}
